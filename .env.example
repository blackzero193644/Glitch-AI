# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Server-side API key for high-speed text, vision, calling, and speech synthesis.
GROQ_API_KEY="MY_GROQ_API_KEY"

# FISH_AUDIO_API_KEY: Server-side API key for natural multilingual voice & TTS.
FISH_AUDIO_API_KEY="MY_FISH_AUDIO_API_KEY"

# AI_HORDE_API_KEY: Server-side API key for distributed AI image synthesis.
AI_HORDE_API_KEY="MY_AI_HORDE_API_KEY"

# JSON2VIDEO_API_KEYS: Comma-separated server-side API keys for cloud video rendering.
JSON2VIDEO_API_KEYS="MY_JSON2VIDEO_KEY_1,MY_JSON2VIDEO_KEY_2,MY_JSON2VIDEO_KEY_3"

# SHOTSTACK_API_KEYS & SHOTSTACK_ENDPOINT: Server-side keys and render endpoint for cloud video editing.
SHOTSTACK_API_KEYS="MY_SHOTSTACK_KEY_1"
SHOTSTACK_ENDPOINT="https://api.shotstack.io/edit/stage/render"

# MAGICHOUR_API_KEY: Server-side API key for Magic Hour image & video pipelines.
MAGICHOUR_API_KEY="MY_MAGICHOUR_API_KEY"

# ZIMAGE_API_KEY: Server-side API key for Z-Image generation pipelines.
ZIMAGE_API_KEY="MY_ZIMAGE_API_KEY"
